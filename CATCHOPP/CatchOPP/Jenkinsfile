pipeline {
    agent any

    environment {
        DOCKER_USER   = 'bunnybanou'
        SONARQUBE_URL = 'http://localhost:9000'
    }

    tools {
        jdk 'jdk'
        maven 'mvn'
    }

    stages {

        // ── 1. Checkout ──────────────────────────────────────────
        stage('Checkout') {
            steps {
                git branch: 'gestion_sub',
                    url: 'https://github.com/Hchaichi8/CATCHOPP.git'
            }
        }

        // ── 2. Backend Build ─────────────────────────────────────
        stage('Build Backend') {
            parallel {
                stage('Build UserMicroService') {
                    steps {
                        dir('CATCHOPP/CatchOPP/UserMicroService') {
                            sh 'mvn clean package -DskipTests'
                        }
                    }
                }
                stage('Build SkillTestsMicroService') {
                    steps {
                        dir('CATCHOPP/CatchOPP/SkillTestsMicroService') {
                            sh 'mvn clean package -DskipTests'
                        }
                    }
                }
                stage('Build SubscriptionMicroService') {
                    steps {
                        dir('CATCHOPP/CatchOPP/SubscriptionMicroService') {
                            sh 'mvn clean package -DskipTests'
                        }
                    }
                }
                stage('Build ReferralMicroService') {
                    steps {
                        dir('CATCHOPP/CatchOPP/ReferralMicroService') {
                            sh 'mvn clean package -DskipTests'
                        }
                    }
                }
            }
        }

        // ── 3. Backend Unit Tests ────────────────────────────────
        stage('Backend Unit Tests') {
            steps {
                dir('CATCHOPP/CatchOPP/SkillTestsMicroService') {
                    sh 'mvn test'
                }
            }
            post {
                always {
                    junit allowEmptyResults: true,
                          testResults: 'CATCHOPP/CatchOPP/SkillTestsMicroService/target/surefire-reports/*.xml'
                }
            }
        }

        // ── 4. Frontend Build & Tests ────────────────────────────
        stage('Frontend CI') {
            steps {
                dir('CATCHOPP/FrontFreelanceApp') {
                    sh '''
                        # Install Node 20 if not present
                        if ! command -v node &> /dev/null; then
                            curl -fsSL https://deb.nodesource.com/setup_20.x | bash -
                            apt-get install -y nodejs
                        fi
                        npm ci
                        npm run build -- --configuration production
                        npx ng test --watch=false --browsers=ChromeHeadless
                    '''
                }
            }
            post {
                always {
                    junit allowEmptyResults: true,
                          testResults: 'CATCHOPP/FrontFreelanceApp/test-results/*.xml'
                }
            }
        }

        // ── 5. SonarQube Analysis ────────────────────────────────
        stage('SonarQube Analysis') {
            steps {
                dir('CATCHOPP/CatchOPP/SkillTestsMicroService') {
                    withCredentials([string(credentialsId: 'sonar_pi', variable: 'SONAR_TOKEN')]) {
                        sh """
                            mvn sonar:sonar \
                            -Dsonar.projectKey=catchopp-skilltests \
                            -Dsonar.projectName='CatchOPP SkillTestsMicroService' \
                            -Dsonar.host.url=${SONARQUBE_URL} \
                            -Dsonar.login=${SONAR_TOKEN} \
                            -Dsonar.java.binaries=target/classes
                        """
                    }
                }
            }
        }

        // ── 6. Build Docker Images ───────────────────────────────
        stage('Build Docker Images') {
            parallel {
                stage('Docker: UserMicroService') {
                    steps {
                        dir('CATCHOPP/CatchOPP/UserMicroService') {
                            sh 'docker build -t bunnybanou/catchopp-user:latest .'
                        }
                    }
                }
                stage('Docker: SkillTestsMicroService') {
                    steps {
                        dir('CATCHOPP/CatchOPP/SkillTestsMicroService') {
                            sh 'docker build -t bunnybanou/catchopp-skilltests:latest .'
                        }
                    }
                }
                stage('Docker: SubscriptionMicroService') {
                    steps {
                        dir('CATCHOPP/CatchOPP/SubscriptionMicroService') {
                            sh 'docker build -t bunnybanou/catchopp-subscription:latest .'
                        }
                    }
                }
                stage('Docker: ReferralMicroService') {
                    steps {
                        dir('CATCHOPP/CatchOPP/ReferralMicroService') {
                            sh 'docker build -t bunnybanou/catchopp-referral:latest .'
                        }
                    }
                }
                stage('Docker: Frontend') {
                    steps {
                        dir('CATCHOPP/FrontFreelanceApp') {
                            sh 'docker build -t bunnybanou/catchopp-frontend:latest .'
                        }
                    }
                }
            }
        }

        // ── 7. Push Docker Images ────────────────────────────────
        stage('Push Docker Images') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'TokenDevOps',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    sh '''
                        echo $DOCKER_PASS | docker login -u $DOCKER_USER --password-stdin
                        docker push bunnybanou/catchopp-user:latest
                        docker push bunnybanou/catchopp-skilltests:latest
                        docker push bunnybanou/catchopp-subscription:latest
                        docker push bunnybanou/catchopp-referral:latest
                        docker push bunnybanou/catchopp-frontend:latest
                        docker logout
                    '''
                }
            }
        }

    }

    post {
        success {
            echo '✅ Full CI/CD pipeline completed successfully!'
        }
        failure {
            echo '❌ Pipeline failed. Check the logs above.'
        }
        always {
            cleanWs()
        }
    }
}
