pipeline {
    agent any

    // ── SCM Polling: check for changes every 5 minutes ──────────
    triggers {
        pollSCM('H/5 * * * *')
    }

    environment {
        DOCKER_USER   = 'bunnybanou'
        SONARQUBE_URL = 'http://localhost:9000'
        GIT_BRANCH    = 'gestion_sub'
    }

    tools {
        jdk 'jdk'
        maven 'mvn'
        nodejs 'nodejs'
    }

    stages {

        // ── 1. Checkout ──────────────────────────────────────────
        stage('Checkout') {
            steps {
                git branch: "${GIT_BRANCH}",
                    url: 'https://github.com/Hchaichi8/CATCHOPP.git'
            }
        }

        // ── 2. Detect what changed ───────────────────────────────
        stage('Detect Changes') {
            steps {
                script {
                    // Get list of changed files compared to previous build
                    def changedFiles = sh(
                        script: "git diff --name-only HEAD~1 HEAD 2>/dev/null || git diff --name-only HEAD 2>/dev/null || echo 'all'",
                        returnStdout: true
                    ).trim()

                    echo "Changed files:\n${changedFiles}"

                    env.BACKEND_CHANGED  = changedFiles.contains('CatchOPP/SkillTestsMicroService') ? 'true' : 'false'
                    env.FRONTEND_CHANGED = changedFiles.contains('FrontFreelanceApp') ? 'true' : 'false'
                    env.ALL_CHANGED      = changedFiles == 'all' ? 'true' : 'false'

                    echo "Backend changed: ${env.BACKEND_CHANGED}"
                    echo "Frontend changed: ${env.FRONTEND_CHANGED}"
                }
            }
        }

        // ══════════════════════════════════════════════════════════
        // BACKEND CI — only runs when SkillTestsMicroService changed
        // ══════════════════════════════════════════════════════════

        stage('Backend CI — Build') {
            when {
                anyOf {
                    environment name: 'BACKEND_CHANGED', value: 'true'
                    environment name: 'ALL_CHANGED', value: 'true'
                }
            }
            steps {
                dir('CATCHOPP/CatchOPP/SkillTestsMicroService') {
                    sh 'mvn clean package -DskipTests'
                }
            }
        }

        stage('Backend CI — Unit Tests') {
            when {
                anyOf {
                    environment name: 'BACKEND_CHANGED', value: 'true'
                    environment name: 'ALL_CHANGED', value: 'true'
                }
            }
            steps {
                dir('CATCHOPP/CatchOPP/SkillTestsMicroService') {
                    sh 'mvn test'
                }
            }
            post {
                always {
                    junit allowEmptyResults: true,
                          testResults: 'CATCHOPP/CatchOPP/SkillTestsMicroService/target/surefire-reports/*.xml'
                }
            }
        }

        stage('Backend CI — SonarQube') {
            when {
                anyOf {
                    environment name: 'BACKEND_CHANGED', value: 'true'
                    environment name: 'ALL_CHANGED', value: 'true'
                }
            }
            steps {
                dir('CATCHOPP/CatchOPP/SkillTestsMicroService') {
                    withCredentials([string(credentialsId: 'sonar_pi', variable: 'SONAR_TOKEN')]) {
                        sh """
                            mvn sonar:sonar \
                            -Dsonar.projectKey=catchopp-skilltests \
                            -Dsonar.projectName='CatchOPP SkillTestsMicroService' \
                            -Dsonar.host.url=${SONARQUBE_URL} \
                            -Dsonar.login=${SONAR_TOKEN} \
                            -Dsonar.java.binaries=target/classes
                        """
                    }
                }
            }
        }

        // ══════════════════════════════════════════════════════════
        // BACKEND CD — Docker build & push
        // ══════════════════════════════════════════════════════════

        stage('Backend CD — Docker Build') {
            when {
                anyOf {
                    environment name: 'BACKEND_CHANGED', value: 'true'
                    environment name: 'ALL_CHANGED', value: 'true'
                }
            }
            steps {
                dir('CATCHOPP/CatchOPP/SkillTestsMicroService') {
                    sh 'docker build -t bunnybanou/catchopp-skilltests:latest .'
                }
            }
        }

        stage('Backend CD — Docker Push') {
            when {
                anyOf {
                    environment name: 'BACKEND_CHANGED', value: 'true'
                    environment name: 'ALL_CHANGED', value: 'true'
                }
            }
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'TokenDevOps',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    sh '''
                        echo $DOCKER_PASS | docker login -u $DOCKER_USER --password-stdin
                        docker push bunnybanou/catchopp-skilltests:latest
                        docker logout
                    '''
                }
            }
        }

        // ══════════════════════════════════════════════════════════
        // FRONTEND CI — only runs when FrontFreelanceApp changed
        // ══════════════════════════════════════════════════════════

        stage('Frontend CI — Install & Build') {
            when {
                anyOf {
                    environment name: 'FRONTEND_CHANGED', value: 'true'
                    environment name: 'ALL_CHANGED', value: 'true'
                }
            }
            steps {
                dir('CATCHOPP/FrontFreelanceApp') {
                    sh 'npm ci'
                    sh 'npm run build -- --configuration production'
                }
            }
        }

        stage('Frontend CI — Unit Tests') {
            when {
                anyOf {
                    environment name: 'FRONTEND_CHANGED', value: 'true'
                    environment name: 'ALL_CHANGED', value: 'true'
                }
            }
            steps {
                dir('CATCHOPP/FrontFreelanceApp') {
                    sh 'npx ng test --watch=false --browsers=ChromeHeadless'
                }
            }
            post {
                always {
                    junit allowEmptyResults: true,
                          testResults: 'CATCHOPP/FrontFreelanceApp/test-results/*.xml'
                }
            }
        }

        // ══════════════════════════════════════════════════════════
        // FRONTEND CD — Docker build & push
        // ══════════════════════════════════════════════════════════

        stage('Frontend CD — Docker Build') {
            when {
                anyOf {
                    environment name: 'FRONTEND_CHANGED', value: 'true'
                    environment name: 'ALL_CHANGED', value: 'true'
                }
            }
            steps {
                dir('CATCHOPP/FrontFreelanceApp') {
                    sh 'docker build -t bunnybanou/catchopp-frontend:latest .'
                }
            }
        }

        stage('Frontend CD — Docker Push') {
            when {
                anyOf {
                    environment name: 'FRONTEND_CHANGED', value: 'true'
                    environment name: 'ALL_CHANGED', value: 'true'
                }
            }
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'TokenDevOps',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    sh '''
                        echo $DOCKER_PASS | docker login -u $DOCKER_USER --password-stdin
                        docker push bunnybanou/catchopp-frontend:latest
                        docker logout
                    '''
                }
            }
        }

    }

    post {
        success {
            echo "✅ Pipeline completed. Backend changed: ${env.BACKEND_CHANGED}, Frontend changed: ${env.FRONTEND_CHANGED}"
        }
        failure {
            echo '❌ Pipeline failed. Check the logs above.'
        }
        always {
            cleanWs()
        }
    }
}
